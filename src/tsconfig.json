{
  "compilerOptions": {
    "target": "ES2020",                  // Modern JS output
    "module": "commonjs",                // Required for VS Code extensions
    "lib": ["ES2020", "DOM"],            // Include modern JS + browser APIs
    "outDir": "dist",                    // Compiled output folder
    "rootDir": "src",                    // Source folder
    "strict": true,                      // Enforce strict type checking
    "esModuleInterop": true,             // Allow default imports from CommonJS
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,                // Skip type checks for node_modules
    "sourceMap": true,                   // Generate source maps for debugging
    "resolveJsonModule": true,           // Allow importing JSON files
    "moduleResolution": "node",          // Node-style module resolution
    "types": ["node", "vscode"]          // Include Node + VS Code typings
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
