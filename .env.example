# =============================================================================
# UCTO - Environment Variables (copy to .env for local development)
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/ucto_db
DATABASE_USER=ucto
DATABASE_PASSWORD=rADHASOAMI@356

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=ucto-backend-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Chargebee
CHARGEBEE_SITE=ucto-test
CHARGEBEE_API_KEY=test_api_key

# Server — change SERVER_HOST to the LAN IP or domain where the backend is reachable
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=noreply@ucto.app
SMTP_PASSWORD=your_smtp_password

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Sentry (optional)
SENTRY_DSN= 
SENTRY_ENVIRONMENT=development
