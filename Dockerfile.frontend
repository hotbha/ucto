# UCTO Frontend - Flutter Web Dockerfile
# Build with: docker compose build frontend
# Override SERVER_HOST/SERVER_PORT at build time:
#   docker compose build --build-arg SERVER_HOST=192.168.1.6 --build-arg SERVER_PORT=8080 frontend
ARG SERVER_HOST=0.0.0.0
ARG SERVER_PORT=8080

FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY frontend .
RUN flutter pub get
RUN flutter build web --release \
    --dart-define=SERVER_HOST=${SERVER_HOST} \
    --dart-define=SERVER_PORT=${SERVER_PORT}

FROM nginx:alpine
COPY --from=build /app/build/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
